{
  "seed": 42,
  "in_len": 8,
  "out_len": 4,
  "hidden": 32,
  "kernel": 3,
  "emb_dim": 10,
  "topk": 10,
  "alpha": 0.5,
  "lr": 0.001,
  "weight_decay": 0.0,
  "batch_size": 64,
  "grad_clip": 5.0,
  "max_epochs": 50,
  "patience": 5,
  "loss": "masked MAE on per-sensor z-scored flow",
  "aggregation": "sum",
  "smoke_test": false,
  "device": "cuda",
  "data": {
    "source": "https://huggingface.co/datasets/TorchSpatiotemporal/ProcessedDatasets/resolve/v1.0.0/large_st/",
    "files": [
      "sensors.zip",
      "2020/data.h5",
      "2021/data.h5"
    ],
    "licence": "CC BY-NC 4.0",
    "subset": "district == 11 (San Diego)",
    "n_sensors": 716,
    "sensor_order": "metadata row order (sd_meta.csv)",
