    "normalisation": {
      "kind": "per-sensor z-score, observed 2020 values only",
      "sensors_without_train_data": 19,
      "sensors_sd_replaced": 0
    }
  },
  "missing_values": "inputs: sensor training mean (0 after z-score); targets: masked from loss and metrics",
  "graph_layer": "H = Z + ReLU(A_hat Z W_g + b_g) (residual), head on H; temporal-only: head on Z",
  "fixed_adjacency": {
    "diagonal": "cleared, then +I once",
    "normalisation": "row"
  },
  "adaptive_adjacency": "softmax_row(relu(E1 E2^T)) -> top-k per row -> row renormalise -> +I -> row normalise",
  "hybrid": "alpha * fixed_hat + (1 - alpha) * adaptive_hat, alpha = 0.5 (not learned)",
  "optimiser": "Adam",
  "early_stopping": "validation MAE, patience 5, best weights restored",
  "training_time": "wall-clock of training loop incl. per-epoch validation; excludes data prep and test evaluation",
  "determinism": "seeded python/numpy/torch, cudnn.deterministic, use_deterministic_algorithms(warn_only=True)",
